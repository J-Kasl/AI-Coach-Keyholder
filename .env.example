# Zkopíruj tento soubor do .env a doplň skutečné hodnoty.
# .env NIKDY necommituj do gitu (viz .gitignore).

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_COMMAND_PREFIX=!

# --- Ollama ------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Database ----------------------------------------------------------------
# Ponech prázdné pro default (data/coach_keyholder.db v rootu projektu)
DB_PATH=

# Kolik posledních automatických záloh ponechat (rotační politika).
# Zálohy vznikají: max. 1x denně při startu + vždy před aplikací migrace.
BACKUP_RETENTION_COUNT=14

# --- Integrace (Fáze 7 — zatím nepovinné) -------------------------------------
CHASTER_API_TOKEN=
APPLE_HEALTH_API_KEY=

# --- Obecné --------------------------------------------------------------------
LOG_LEVEL=INFO
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
