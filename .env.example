# Copy this file to .env and fill in real values.
# NEVER commit .env to git (see .gitignore).

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_COMMAND_PREFIX=!

# --- Ollama ------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Database ----------------------------------------------------------------
# Leave blank for the default (data/coach_keyholder.db at the project root)
DB_PATH=

# How many recent automatic backups to keep (rotation policy).
# Backups are created: at most once a day at startup + always before applying a migration.
BACKUP_RETENTION_COUNT=14

# --- Integrations (Phase 7 — optional for now) -------------------------------------
CHASTER_API_TOKEN=
APPLE_HEALTH_API_KEY=

# --- General --------------------------------------------------------------------
LOG_LEVEL=INFO
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
